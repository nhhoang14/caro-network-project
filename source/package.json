{
  "name": "caro-network-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"mvn -f server/pom.xml spring-boot:run\" \"npm run dev:client\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "mvn -f server/pom.xml spring-boot:run",
    "build": "tsc --noEmit -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "mvn -f server/pom.xml spring-boot:run",
    "test": "mvn -f server/pom.xml test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
